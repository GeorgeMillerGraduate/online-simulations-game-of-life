#N loafer-mwss-signal-loop.rle.gz
#O Goldtiger997, 1 May 2018
#C
#C The glider-to-loafer V-converter on the right side uses Snarks,
#C syringes and various Herschel-based splitters to synchronize
#C 10 gliders to make an 8-glider loafer recipe, with two kickbacks.
#C
#C The glider synchronization uses a "doubled-signal toolkit":
#C each signal is doubled before it enters the signal splitting
#C mechanism, and a period doubler on each signal path allows a
#C free choice of two different timings (mod 8).  Adjustments of
#C +/-8N can be done on any path by moving a 180-degree reflector
#C by N cells diagonally.
#C
#C Reference:
#C http://www.conwaylife.com/forums/viewtopic.php?p=59723#p59723
x = 983, y = 647, rule = B3/S23
